{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  "include": ["src/app", "src/shared/ui", "src/shared/types.ts", "src/features/*/ui"],
  "exclude": ["**/*.test.ts"]
}
